%h1= t('.title')

- if @products.present?
  = paginate @products
  %ul{ 'data-controller' => 'sortable', 'data-sortable-animation-value' => '150' }
    -# %tr.text-nowrap
    -#   %th= Product.human_attribute_name(:name)
    -#   %th= Product.human_attribute_name(:price_without_tax)
    -#   %th
    - @products.each do |product|
      %li.handle
        .border= product.name
        .border.text-nowrap= number_to_currency(product.price_without_tax)
        .border
          = simple_form_for [:admins, product] do |f|
            = f.input :position
            = f.button :submit
  = paginate @products
- else
  = t('general.none')
